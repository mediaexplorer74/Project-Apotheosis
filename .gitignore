# ==== Build output / intermediates ====
# NOTE: a pattern containing a slash is anchored to THIS .gitignore's directory (the repo root).
# The harness lives under Src/, so "harness/AppPackages/" would NOT match "Src/harness/AppPackages/".
# These are therefore written unanchored (no slash) to match at any depth.
build-*/
build-clang-webcore/
build-clang-jit/
build-clang-release/
build-release/
deps-build/
*-build/
AppPackages/
Src/harness/ARM/
Src/harness/Harness/
Generated Files/
obj/
*.pch
*.dmp
crash/
*.appx
*.appxsym
*.appxbundle
# per-version appx build intermediates (what leaked before the path fix)
*.psd1
*.resfiles
*.xbf
*.intermediate
*.cer
*.pri
*.appxmanifest.xml

# ==== Binary / intermediate products ====
*.obj
*.lib
*.dll
*.pdb
*.exe
*.ilk
*.exp
*.winmd
*.pri
*.tlog
*.idb
*.iobj
*.ipdb

# ==== WebKit source (GB-level; engine patches tracked in memory) ====
WebKit/

# ==== Downloaded ANGLE binaries (re-downloadable; headers angle/include still tracked) ====
angle/arm/
angle-windowsstore/

# ==== Logs / runtime status ====
*.log
jit-verify-result.txt
jit-verify-status.txt
gpu-verify-result.txt
gpu-verify-status.txt
gpu-build-status.txt
deploy-status.txt
stage.txt
gpuprobe.txt
jitresult.txt

# ==== Fonts (re-downloadable) ====
*.ttf
*.ttc
*.otf

# ==== Fork temp backup ====
.gpu-backup/

# ==== Signing keys ====
*.pfx

