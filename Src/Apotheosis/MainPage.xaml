<Page
    x:Class="Apotheosis.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <Page.Resources>
        <SolidColorBrush x:Key="PageBg"   Color="#FF161618"/>
        <SolidColorBrush x:Key="Chrome"   Color="#FF2A2A2C"/>
        <SolidColorBrush x:Key="Surface"  Color="#FF323234"/>
        <SolidColorBrush x:Key="Inset"    Color="#FF1B1B1D"/>
        <SolidColorBrush x:Key="Sep"      Color="#22FFFFFF"/>
        <SolidColorBrush x:Key="TxtHi"    Color="#FFF2F2F3"/>
        <SolidColorBrush x:Key="TxtLo"    Color="#FF9BA0A6"/>
        <SolidColorBrush x:Key="Accent"   Color="#FF3AA0FF"/>
        <SolidColorBrush x:Key="Scrim"    Color="#B3000000"/>

        <Style x:Key="NavBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TxtHi}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="Width" Value="50"/>
            <Setter Property="Height" Value="54"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TxtHi}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TxtLo}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
        <Style x:Key="QuickBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TxtHi}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0,10"/>
        </Style>
        <Style x:Key="MenuRow" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource TxtHi}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="Padding" Value="18,13"/>
        </Style>
        <Style x:Key="SetRow" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Surface}"/>
            <Setter Property="Foreground" Value="{StaticResource TxtHi}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,12"/>
        </Style>
    </Page.Resources>

    <Grid x:Name="RootGrid" Background="{StaticResource PageBg}">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="RootShift" Y="0"/>
        </Grid.RenderTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Content area: web page rendering + overlays -->
        <Grid Grid.Row="0">
            <Border Background="White">
                <Grid x:Name="ContentArea" Background="White"
                      SizeChanged="OnContentAreaSizeChanged"
                      ManipulationMode="TranslateX,TranslateY,TranslateInertia,Scale"
                      IsTapEnabled="True" Tapped="OnPageTapped"
                      ManipulationStarting="OnManipStarting"
                      ManipulationDelta="OnImageManipDelta"
                      ManipulationCompleted="OnImageManipCompleted"
                      PointerWheelChanged="OnContentWheel">
                    <!-- S7 (2026-10-22): FrameFit carries the display scale of the fixed frame:
                         the whole 720x1080 bitmap drawn as large as fits the window, top-left
                         anchored. RenderImage itself keeps a free RenderTransform for the live
                         pinch preview (ApplyLiveZoom), which is why the base scale is on the
                         wrapper and not on the Image: the two must compose, not overwrite. -->
                    <Grid x:Name="FrameFit" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="FrameFitScale" ScaleX="1" ScaleY="1"/>
                        </Grid.RenderTransform>
                        <Image x:Name="RenderImage" Stretch="None" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    </Grid>
                </Grid>
            </Border>

            <SwapChainPanel x:Name="GpuPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            IsHitTestVisible="False" Visibility="Collapsed"/>

            <TextBox x:Name="ImeBox" Width="1" Height="1" Opacity="0" Margin="0" Padding="0"
                     BorderThickness="0" MinWidth="0" MinHeight="0"
                     HorizontalAlignment="Left" VerticalAlignment="Top" IsTabStop="True"
                     TextChanged="OnImeTextChanged" KeyDown="OnImeKeyDown"/>

            <ProgressBar x:Name="Progress" Height="2.5" VerticalAlignment="Top" Foreground="{StaticResource Accent}"
                         Background="Transparent" IsIndeterminate="False" Visibility="Collapsed"/>

            <StackPanel x:Name="ScrollFab" Orientation="Vertical" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,14,16" Visibility="Collapsed">
                <!-- Apotheosis 2026-09-26: these were 48x48 with CornerRadius=24, i.e. perfect circles
                     floating over the page. Retro-Metro is strictly sharp-cornered, so the radius is
                     gone and the glyphs are centred on a flat square. Apotheosis 2026-10-03: hiding
                     them is now a Settings switch ("On-screen scroll buttons"), persisted as
                     touchfab= in settings.ini. The maintainer's laptop and both Lumia targets have a
                     real touchscreen, so on those this pair is clutter over the page. The gate is
                     _showFab, ANDed with the session state; OnScrollUp/OnScrollDown stay callable. -->
                <Border Width="48" Height="48" CornerRadius="0" Background="#CC2A2A2C" Margin="0,0,0,10">
                    <Button Width="48" Height="48" Padding="0" Background="Transparent" Foreground="#FFFFFFFF"
                            FontSize="19" BorderThickness="0" Content="&#x25B2;" Click="OnScrollUp"/>
                </Border>
                <Border Width="48" Height="48" CornerRadius="0" Background="#E63AA0FF">
                    <Button Width="48" Height="48" Padding="0" Background="Transparent" Foreground="#FFFFFFFF"
                            FontSize="19" BorderThickness="0" Content="&#x25BC;" Click="OnScrollDown"/>
                </Border>
            </StackPanel>

            <!-- Find bar -->
            <Border x:Name="FindBar" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                    Background="{StaticResource Chrome}" BorderBrush="{StaticResource Sep}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                <Grid Margin="8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{StaticResource Inset}" CornerRadius="8">
                         <TextBox x:Name="FindBox" FontSize="15" Height="36" BorderThickness="0" Background="Transparent"
                                  Foreground="{StaticResource TxtHi}" VerticalContentAlignment="Center" Padding="10,0"
                                  KeyDown="OnFindKeyDown" TextChanged="OnFindChanged"/>
                    </Border>
                    <TextBlock x:Name="FindCount" Grid.Column="1" Text="" Foreground="{StaticResource TxtLo}" FontSize="13" VerticalAlignment="Center" Margin="10,0"/>
                    <Button x:Name="FindPrev" Grid.Column="2" Style="{StaticResource IconBtn}" Content="&#x25B2;" FontSize="13" Click="OnFindPrev"/>
                    <Button x:Name="FindNext" Grid.Column="3" Style="{StaticResource IconBtn}" Content="&#x25BC;" FontSize="13" Click="OnFindNext"/>
                    <Button x:Name="FindClose" Grid.Column="4" Style="{StaticResource IconBtn}" Content="&#x2715;" Click="OnFindClose"/>
                </Grid>
            </Border>

            <!-- Suggestion dropdown.
                 Anchored to the bottom because the address bar is at the bottom: a list that grew
                 downward from here would grow off-screen. MaxHeight is deliberately a fraction of
                 the content area and not most of it. At 340 a full match list covered the page
                 behind it (see the MakeRow note in MainPage.xaml.cs), and on a 360-DIP phone the
                 same number is nearly the entire window. -->
            <Border x:Name="SuggestPanel" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                    Background="#F22A2A2C" BorderBrush="{StaticResource Sep}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                <!-- MaxHeight is the desktop ceiling; ShowSuggestions clamps the same ScrollViewer
                     again against a fraction of the content area, because 250 DIP is most of a
                     360-DIP-wide phone window and this list must never be the whole page. -->
                <ScrollViewer x:Name="SuggestScroll" MaxHeight="250" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SuggestList" Margin="8,6"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Bottom chrome: status + navigation bar -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Chrome}">
                <TextBlock x:Name="TitleText" Text="EdgeHTML Reborn" Foreground="{StaticResource TxtLo}" FontSize="11"
                           HorizontalAlignment="Center" Margin="14,3,14,2" TextTrimming="CharacterEllipsis"/>
            </Border>

            <Grid Grid.Row="1" Height="54" Background="{StaticResource Chrome}" BorderBrush="{StaticResource Sep}" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="TabsBtn" Grid.Column="0" Background="Transparent" BorderThickness="0" Width="50" Height="54" Padding="0" Click="OnTabs">
                    <Border BorderBrush="{StaticResource TxtHi}" BorderThickness="2" CornerRadius="5" Width="24" Height="24">
                        <TextBlock x:Name="TabCountText" Text="1" Foreground="{StaticResource TxtHi}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Button>

                <Rectangle Grid.Column="1" Fill="{StaticResource Sep}" Width="1" Height="22" VerticalAlignment="Center"/>

                <Border Grid.Column="2" Background="{StaticResource Inset}" CornerRadius="9" Margin="6,8" Padding="0" Height="38">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LockIcon" Grid.Column="0" Text="" FontFamily="Segoe MDL2 Assets"
                                   FontSize="14" Foreground="{StaticResource TxtLo}" TextLineBounds="Tight"
                                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10,0,2,0"/>
                         <TextBox x:Name="UrlBox" Grid.Column="1" FontSize="15" Height="38" BorderThickness="0" Background="Transparent"
                                  Foreground="{StaticResource TxtHi}" VerticalAlignment="Center" VerticalContentAlignment="Center" Padding="6,0"
                                  InputScope="Url" Text=""
                                 KeyDown="OnUrlKeyDown" TextChanged="OnUrlChanged"
                                 GotFocus="OnUrlGotFocus" LostFocus="OnUrlLostFocus"/>
                        <Button x:Name="UrlActionBtn" Grid.Column="2" Background="Transparent" BorderThickness="0"
                                Foreground="{StaticResource TxtHi}" Width="40" Height="38" Padding="0" FontSize="16"
                                VerticalAlignment="Center" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                Content="&#x21BB;" Click="OnUrlAction"/>
                    </Grid>
                </Border>

                <Rectangle Grid.Column="3" Fill="{StaticResource Sep}" Width="1" Height="22" VerticalAlignment="Center"/>

                <Button x:Name="MenuBtn" Grid.Column="4" Style="{StaticResource NavBtn}" Content="&#xE712;" Click="OnMenu"/>
            </Grid>
        </Grid>

        <!-- Action menu (bottom sheet) -->
        <Grid x:Name="ActionMenu" Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource Scrim}" Visibility="Collapsed" Tapped="OnActionScrimTap">
            <Border VerticalAlignment="Bottom" Background="{StaticResource Surface}" CornerRadius="16,16,0,0" Tapped="OnSheetTap">
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="520">
                    <StackPanel Margin="0,10,0,16">
                        <Border Width="40" Height="4" CornerRadius="2" Background="#55FFFFFF" Margin="0,0,0,12"/>

                        <Grid Margin="6,2,6,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BackBtn" Grid.Column="0" Click="OnBack" Style="{StaticResource QuickBtn}" IsEnabled="False">
                                <StackPanel>
                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center" Foreground="{StaticResource TxtHi}"/>
                                    <TextBlock x:Name="BackLabel" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource TxtLo}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="FwdBtn" Grid.Column="1" Click="OnForward" Style="{StaticResource QuickBtn}" IsEnabled="False">
                                <StackPanel>
                                    <TextBlock Text="&#xE72A;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center" Foreground="{StaticResource TxtHi}"/>
                                    <TextBlock x:Name="FwdLabel" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource TxtLo}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Tag="reload" Click="OnAction" Style="{StaticResource QuickBtn}">
                                <StackPanel>
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center" Foreground="{StaticResource TxtHi}"/>
                                    <TextBlock x:Name="ReloadLabel" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource TxtLo}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3" Tag="bookmark" Click="OnAction" Style="{StaticResource QuickBtn}">
                                <StackPanel>
                                    <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="22" HorizontalAlignment="Center" Foreground="#FFFFD24A"/>
                                    <TextBlock x:Name="ActFavLabel" FontSize="12" HorizontalAlignment="Center" Foreground="{StaticResource TxtLo}" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border Height="1" Background="{StaticResource Sep}" Margin="14,4"/>

                        <Button Tag="newtab" Click="OnAction" Style="{StaticResource MenuRow}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="34" VerticalAlignment="Center" Foreground="{StaticResource TxtLo}"/>
                                <TextBlock x:Name="NewTabLabel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="home" Click="OnAction" Style="{StaticResource MenuRow}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="34" VerticalAlignment="Center" Foreground="{StaticResource TxtLo}"/>
                                <TextBlock x:Name="HomeLabel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="ua" Click="OnAction" Style="{StaticResource MenuRow}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="34" VerticalAlignment="Center" Foreground="{StaticResource TxtLo}"/>
                                <TextBlock x:Name="ActUaLabel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="find" Click="OnAction" Style="{StaticResource MenuRow}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="34" VerticalAlignment="Center" Foreground="{StaticResource TxtLo}"/>
                                <TextBlock x:Name="FindInPageLabel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="share" Click="OnAction" Style="{StaticResource MenuRow}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72D;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="34" VerticalAlignment="Center" Foreground="{StaticResource TxtLo}"/>
                                <TextBlock x:Name="ShareLabel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="copylink" Click="OnAction" Style="{StaticResource MenuRow}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="34" VerticalAlignment="Center" Foreground="{StaticResource TxtLo}"/>
                                <TextBlock x:Name="CopyLinkLabel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="download" Click="OnAction" Style="{StaticResource MenuRow}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="34" VerticalAlignment="Center" Foreground="{StaticResource TxtLo}"/>
                                <TextBlock x:Name="DownloadLabel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{StaticResource Sep}" Margin="14,4"/>

                        <Button Tag="bookmarks" Click="OnAction" Style="{StaticResource MenuRow}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="34" VerticalAlignment="Center" Foreground="{StaticResource TxtLo}"/>
                                <TextBlock x:Name="BookmarksLabel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="history" Click="OnAction" Style="{StaticResource MenuRow}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="34" VerticalAlignment="Center" Foreground="{StaticResource TxtLo}"/>
                                <TextBlock x:Name="HistoryLabel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Tag="downloads" Click="OnAction" Style="{StaticResource MenuRow}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="34" VerticalAlignment="Center" Foreground="{StaticResource TxtLo}"/>
                                <TextBlock x:Name="DownloadsLabel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <Border Height="1" Background="{StaticResource Sep}" Margin="14,4"/>

                        <Button Tag="settings" Click="OnAction" Style="{StaticResource MenuRow}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="34" VerticalAlignment="Center" Foreground="{StaticResource TxtLo}"/>
                                <TextBlock x:Name="SettingsLabel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Drawer: favorites/history/downloads -->
        <Grid x:Name="Drawer" Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource PageBg}" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="{StaticResource Chrome}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="DrawerTitle" Foreground="{StaticResource TxtHi}" FontSize="22" FontWeight="SemiBold" Margin="16,0" VerticalAlignment="Center"/>
                <Button x:Name="GpuBtn" Grid.Column="1" Style="{StaticResource TabBtn}" Foreground="{StaticResource TxtLo}"
                        Content="GPU" Click="OnToggleGpu" VerticalAlignment="Center"/>
                <Button x:Name="UaBtn" Grid.Column="2" Style="{StaticResource TabBtn}" Foreground="{StaticResource Accent}"
                        Click="OnToggleUA" VerticalAlignment="Center"/>
                <Button Grid.Column="3" Style="{StaticResource IconBtn}" Content="&#x2715;" Click="OnDrawerClose"/>
            </Grid>

            <Grid Grid.Row="1" Background="{StaticResource Surface}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="TabFav"  Grid.Column="0" Style="{StaticResource TabBtn}" Click="OnTabFav"/>
                <Button x:Name="TabHist" Grid.Column="1" Style="{StaticResource TabBtn}" Click="OnTabHist"/>
                <Button x:Name="TabDl"   Grid.Column="2" Style="{StaticResource TabBtn}" Click="OnTabDl"/>
                <Button x:Name="ActionBtn" Grid.Column="3" Style="{StaticResource TabBtn}" Foreground="{StaticResource Accent}" Click="OnPrimaryAction"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="DrawerList" Margin="8"/>
            </ScrollViewer>
        </Grid>

        <!-- Settings page -->
        <Grid x:Name="SettingsPage" Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource PageBg}" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{StaticResource Chrome}" Padding="3,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource IconBtn}" FontFamily="Segoe MDL2 Assets" Content="&#xE72B;" Click="OnSettingsBack"/>
                <TextBlock Grid.Column="1" x:Name="SettingsTitle" Foreground="{StaticResource TxtHi}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0"/>
            </Grid>
            <!-- General / Advanced split. A Pivot rather than one long scrolling list: the
                 settings that change what the user browses and the ones that change how the
                 engine runs should not compete for the same screen, and the Advanced set is
                 the one a person changes rarely and regrets easily (GPU, logging). -->
            <Pivot x:Name="SettingsPivot" Grid.Row="1" Background="Transparent">
            <PivotItem x:Name="SettingsGeneralItem">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,12">
                    <TextBlock x:Name="SettingsDefaultSearch" Foreground="{StaticResource TxtLo}" FontSize="13" Margin="0,8,0,4"/>
                    <ComboBox x:Name="SetSearchCombo" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Bing"/>
                        <ComboBoxItem Content="Google"/>
                        <ComboBoxItem Content="DuckDuckGo"/>
                        <ComboBoxItem Content="Baidu"/>
                    </ComboBox>

                    <TextBlock x:Name="SettingsLanguage" Foreground="{StaticResource TxtLo}" FontSize="13" Margin="0,18,0,4"/>
                    <ComboBox x:Name="SetLangCombo" HorizontalAlignment="Stretch" SelectionChanged="OnLangChanged">
                        <ComboBoxItem Content="English"/>
                        <ComboBoxItem Content="Русский"/>
                        <ComboBoxItem Content="中文"/>
                    </ComboBox>

                    <TextBlock x:Name="SettingsHomepage" Foreground="{StaticResource TxtLo}" FontSize="13" Margin="0,18,0,4"/>
                    <TextBox x:Name="SetHomeBox" HorizontalAlignment="Stretch" InputScope="Url" PlaceholderText="about:home"/>

                    <ToggleSwitch x:Name="SetUaSwitch" Foreground="{StaticResource TxtHi}" Margin="0,18,0,0"
                                  Toggled="OnUaSwitchToggled"/>

                    <TextBlock x:Name="SettingsCustomUA" Foreground="{StaticResource TxtLo}" FontSize="13" Margin="0,16,0,4"/>
                    <TextBox x:Name="SetUaCustomBox" HorizontalAlignment="Stretch" TextWrapping="Wrap" AcceptsReturn="False"
                             PlaceholderText="Mozilla/5.0 (Windows NT 10.0; Win64; x64) ... Chrome/120 Safari/537.36 Edg/120"/>

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="SettingsDefaultZoom" Foreground="{StaticResource TxtHi}" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="SetZoomLabel" Text="100%" Foreground="{StaticResource TxtLo}" FontSize="14" VerticalAlignment="Center"/>
                    </Grid>
                    <Slider x:Name="SetZoomSlider" Minimum="50" Maximum="200" StepFrequency="10" Value="100" ValueChanged="OnZoomChanged"/>

                    <!-- The touch-emulation pair over the page. Read on close like the UA switch
                         above, so it takes effect when Settings is dismissed. -->
                    <ToggleSwitch x:Name="SetFabSwitch" Foreground="{StaticResource TxtHi}" Margin="0,18,0,0"/>

                    <!-- Apotheosis 2026-10-27 (.97): the Fit toggle was removed here. The viewport
                         is always fitted to the window, and Zoom is the only scale control. -->

                    <!-- The address-bar dropdown (history + typed-site matches), gated in
                         ShowSuggestions(). On by default; turning it off leaves the box silent
                         across the whole sheet's lifetime, not just until the next load. -->
                    <ToggleSwitch x:Name="SetSuggestSwitch" Foreground="{StaticResource TxtHi}" Margin="0,18,0,0"/>
                </StackPanel>
            </ScrollViewer>
            </PivotItem>
            <PivotItem x:Name="SettingsAdvancedItem">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="18,12">
                    <ToggleSwitch x:Name="SetTabModeSwitch" IsEnabled="False" Foreground="{StaticResource TxtHi}" Margin="0,4,0,0"/>

                    <!-- Headless mode — register-only placeholder for the ROADMAP "Beyond 1.0"
                         idea (fetch → analyse → summary or TTS instead of pixels). The choice is
                         saved as headless= in settings.ini; nothing reads it yet. -->
                    <TextBlock x:Name="SettingsHeadlessSection" Foreground="{StaticResource TxtLo}" FontSize="13" Margin="0,18,0,4"/>
                    <ComboBox x:Name="SetHeadlessCombo" HorizontalAlignment="Stretch">
                        <ComboBoxItem Content="Off"/>
                        <ComboBoxItem Content="Summary"/>
                        <ComboBoxItem Content="Speak"/>
                    </ComboBox>
                    <TextBlock x:Name="SetHeadlessHint" Foreground="{StaticResource TxtLo}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,4,0,6"/>

                    <TextBlock x:Name="SettingsGpuSection" Foreground="{StaticResource TxtLo}" FontSize="13" Margin="0,18,0,4"/>
                    <ToggleSwitch x:Name="SetGpuSwitch" Foreground="{StaticResource TxtHi}" Margin="0,0,0,6"/>
                    <Button x:Name="SetGpuNowBtn" Tag="gpu" Click="OnSettingsBtn" Style="{StaticResource SetRow}"/>

                    <!-- Logger. Not cosmetic: on this build the only evidence of what the engine
                         did is a file in LocalState, so turning tracing off trades diagnosis for
                         disk and I/O. Off is the right default for a person just reading pages.
                         No section heading: the switch carries its own header. -->
                    <ToggleSwitch x:Name="SetLogSwitch" Foreground="{StaticResource TxtHi}" Margin="0,18,0,6"
                                  Toggled="OnLogSwitchToggled"/>
                    <TextBlock x:Name="SetLogHint" Foreground="{StaticResource TxtLo}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>

                    <TextBlock x:Name="SettingsClearData" Foreground="{StaticResource TxtLo}" FontSize="13" Margin="0,18,0,4"/>
                    <Button x:Name="SetClearHistBtn" Tag="clearhist" Click="OnSettingsBtn" Style="{StaticResource SetRow}" Margin="0,0,0,6"/>
                    <Button x:Name="SetClearFavBtn" Tag="clearfav" Click="OnSettingsBtn" Style="{StaticResource SetRow}" Margin="0,0,0,6"/>
                    <Button x:Name="SetClearDlBtn" Tag="cleardl" Click="OnSettingsBtn" Style="{StaticResource SetRow}"/>

                    <TextBlock x:Name="SettingsDiagnostics" Foreground="{StaticResource TxtLo}" FontSize="13" Margin="0,18,0,4"/>
                    <Button x:Name="SetExportBtn" Tag="export" Click="OnSettingsBtn" Style="{StaticResource SetRow}"/>

                    <TextBlock x:Name="SettingsAboutUpdate" Foreground="{StaticResource TxtLo}" FontSize="13" Margin="0,18,0,4"/>
                    <TextBlock x:Name="VersionText" Text="Version —" Foreground="{StaticResource TxtHi}" FontSize="15" Margin="0,0,0,8"/>
                    <Button x:Name="SetCheckUpdateBtn" Tag="checkupdate" Click="OnSettingsBtn" Style="{StaticResource SetRow}"/>

                    <TextBlock x:Name="SettingsFooter"
                               Foreground="#FF80868B" FontSize="12" TextWrapping="Wrap" Margin="0,22,0,24"/>
                </StackPanel>
            </ScrollViewer>
            </PivotItem>
            </Pivot>
        </Grid>

        <!-- Tab switcher -->
        <Grid x:Name="TabSwitcher" Grid.Row="0" Grid.RowSpan="2" Background="{StaticResource PageBg}" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Background="{StaticResource Chrome}" Padding="6,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="TabSwitcherTitle" Foreground="{StaticResource TxtHi}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0"/>
                <Button x:Name="TabSwitcherDone" Grid.Column="1" Style="{StaticResource TabBtn}" Foreground="{StaticResource Accent}" Click="OnTabSwitcherDone"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="TabList" Margin="10,10"/>
            </ScrollViewer>
            <Button Grid.Row="2" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                    Background="{StaticResource Chrome}" Foreground="{StaticResource Accent}" Padding="0,15" Click="OnNewTab">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                    <TextBlock x:Name="NewTabButton" Text="New Tab" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Accent}"/>
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
