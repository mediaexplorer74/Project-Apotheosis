<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  IgnorableNamespaces="uap mp uap3">

  <Identity Name="ME.Apotheosis"
            Publisher="CN=media"
            Version="0.2.3.29"
            ProcessorArchitecture="arm" />

  <mp:PhoneIdentity PhoneProductId="b3a9e5c2-1d4f-4a7b-9c8e-0f1a2b3c4d5e" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>Apotheosis 0.2.3.29</DisplayName>
    <PublisherDisplayName>Admin</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.14393.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <!-- Listed explicitly, without x-generate. x-generate made the build derive this
         list from the PRIResource items, and it emitted only EN-US into the generated
         manifest while still producing language-ru/zh-hans resource packages, so those
         two were built and then never declared: they would not install, and x:Uid would
         fall back to the default language for a Russian or Chinese user. zh-CN is gone
         because there is no zh-CN Resources.resw; zh-Hans is the Simplified pack.

         Apotheosis 2026-10-03: the UI no longer reads these. The strings live in the
         table in Str.cs, because a .resw is bound to the VIEW language and cannot be
         repainted while the app runs, which is what "the language setting does not
         repaint the UI" turned out to be. The resources are still shipped and the
         languages still declared: the .resw files are this fork's translation corpus,
         and dropping them from the package is a separate packaging decision. To retire
         them, delete the PRIResource items in Apotheosis.csproj and the three files. -->
    <Resource Language="en-US"/>
    <Resource Language="ru-RU"/>
    <Resource Language="zh-Hans"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="Apotheosis.App">
      <uap:VisualElements
        DisplayName="Apotheosis 0.2.3.29"
        Description="Modern WebKit browser on Windows 10 Mobile (ARM32)"
        BackgroundColor="#1E1E1E"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
        <uap:DefaultTile Square71x71Logo="Assets\SmallTile.png" Wide310x150Logo="Assets\WideTile.png" Square310x310Logo="Assets\LargeTile.png"/>
        <uap:InitialRotationPreference>
          <uap:Rotation Preference="landscape"/>
          <uap:Rotation Preference="portrait"/>
          <uap:Rotation Preference="landscapeFlipped"/>
          <uap:Rotation Preference="portraitFlipped"/></uap:InitialRotationPreference>
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="codeGeneration" />
    <uap:Capability Name="removableStorage"/>
    <uap3:Capability Name="backgroundMediaPlayback"/>
  </Capabilities>
</Package>
