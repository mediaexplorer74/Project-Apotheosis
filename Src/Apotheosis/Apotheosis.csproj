    <!--
      fontconfig runs inside an App Container, which has no system font directory.
      SetupRuntimeEnv points FONTCONFIG_FILE at <installDir>\Assets\fonts, so the fonts
      MUST ship there with the subfolder preserved (Link), otherwise they land in the
      package root and the first cairo_scaled_font_create faults - a native exception
      through the P/Invoke boundary, which .NET Native turns into FailFast(7) and kills
      the process with no dump and no catchable exception. Same five files the native
      harness ships in Src\harness\Assets\fonts.
    -->
    <Content Include="Assets\fonts\*.ttf">
      <Link>Assets\fonts\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!--
      Apotheosis 2026-10-20: an acceptance-only command batch for the ARM line.

      Device Portal can read LocalState but every spelling of a write to it returns HTTP 500
      (see Src\tools\pull-device-logs.ps1), so the only way to script a run on the Lumia is to
      ship the batch inside the appx. MainPage.AutoCmd.cs reads this file at startup and runs it
      once per package version.

      The Exists condition keeps it out of a normal build: the file is staged by
      Src\tools\build-app-accept.ps1 for the duration of an acceptance build and removed
      afterwards, so a product appx carries no batch and the app's first check finds nothing.
    -->
    <Content Include="Assets\device-run.txt" Condition="Exists('Assets\device-run.txt')">
      <Link>Assets\device-run.txt</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!--
    Native WebKit driver payload, selected by $(Platform).

    The DLLs MUST land at the package ROOT (see Link= below). The DllImport
    declarations in WebCoreDriver.cs use bare filenames such as
    "WebCoreDriver.dll", and an AppContainer only resolves those against the
    package root - a native\x64\ subdirectory would require SetDllDirectory,
    which is unavailable there. Without Link= the files would be staged under
    native\ and every P/Invoke would fail with 0x8007007E.

    $(Platform) picks the architecture:
      x64  -> native\x64\*.dll  (engine set built today)
      ARM  -> native\ARM\*.dll  (populated 2026-10-03: 22 DLLs, the driver
                                 relinked against WebCoreFull-arm32.lib)
    Dropping ARM binaries into native\ARM\ is therefore enough - no further
    project-file editing needed. (The on-disk folder is native\ARM in upper
    case; the x64 one is lower case. Windows folds the difference.)

    WebCore.dll is explicitly EXCLUDED from both globs. Since 2026-09-26 the
    driver links WebCore statically (WebCoreFull-x64-19041.lib /
    WebCoreFull-arm32.lib), so WebCoreDriver.dll does not import WebCore.dll and
    the file is dead weight - 44 MB on x64. On a 1 GB Lumia that is not a
    rounding error, so the exclusion is enforced here rather than relying on
    someone remembering to delete the file.
  -->
  <ItemGroup Condition=" '$(Platform)' == 'x64' ">
    <Content Include="native\x64\*.dll" Exclude="native\x64\WebCore.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition=" '$(Platform)' == 'ARM' ">
    <Content Include="native\ARM\*.dll" Exclude="native\ARM\WebCore.dll">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
