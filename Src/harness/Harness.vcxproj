      <AdditionalOptions>/utf-8 /bigobj %(AdditionalOptions)</AdditionalOptions>
      <Optimization>MaxSpeed</Optimization>
    </ClCompile>
    <Link>
      <!-- Phase 1b: 链接 build-clang-webcore 的 4 个引擎库 + 驱动/stub 库 + 全部软渲染依赖。
           顺序 WebCore->JSC->PAL->WTF(被依赖者在后);MS link.exe 多遍解析,顺序容错。 -->
      <AdditionalDependencies>libEGL.lib;libGLESv2.lib;WebCoreDriver-gpu.lib;WebCore.lib;JavaScriptCore.lib;PAL.lib;WTF.lib;JavaScriptCore.lib;WTF.lib;libcurl.lib;libssl.lib;libcrypto.lib;cairo.lib;pixman-1.lib;freetype.lib;fontconfig.lib;libexpat.lib;harfbuzz.lib;jpeg.lib;libpng16.lib;libwebp.lib;libwebpdemux.lib;libsharpyuv.lib;libxml2.lib;sqlite3.lib;z.lib;bz2.lib;brotlidec.lib;brotlicommon.lib;icuuc.lib;icuin.lib;icudt.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories Condition="'$(APOTHEOSIS_BUILD_GPU)'!=''">$(APOTHEOSIS_BUILD_GPU);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalLibraryDirectories>$(ProjectDir)..\port;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalLibraryDirectories Condition="'$(Platform)'=='ARM'">$(ProjectDir)..\angle\arm;C:\vcpkg\installed\arm-uwp\lib;C:\icu-arm-uwp\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalLibraryDirectories Condition="'$(Platform)'=='x64'">$(ProjectDir)..\angle\x64;C:\vcpkg\installed\x64-uwp\lib;C:\icu-x64-uwp\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <!-- 与 lld-link 验证一致:/OPT:REF 死剥未引用代码,只保留渲染路径闭包(146 stub 覆盖之)。 -->
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>false</EnableCOMDATFolding>
      <!-- Apotheosis: JSC CLoop 解释器(无 JIT)极耗原生栈;真实站点 JS 递归会爆默认 1MB
           线程栈 → 栈溢出闪退(且无 dump)。把 exe 默认栈预留调到 16MB,std::thread 用
           的就是这个 PE 默认栈大小。 -->
      <StackReserveSize>16777216</StackReserveSize>
    </Link>
  </ItemDefinitionGroup>
