  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <!-- Pre-build: copy all runtime DLLs to output dir for Appx packaging (x64 only) -->
  <PropertyGroup Condition="'$(Platform)'=='x64'">
    <PreBuildEvent>
      if not exist "$(OutDir)WebCore.dll" copy /Y "$(ProjectDir)..\..\build-x64-gpu\bin\WebCore.dll" "$(OutDir)WebCore.dll"
      if not exist "$(OutDir)JavaScriptCore.dll" copy /Y "$(ProjectDir)..\..\build-x64-gpu\bin\JavaScriptCore.dll" "$(OutDir)JavaScriptCore.dll"

      if not exist "$(OutDir)icuuc78.dll" copy /Y "C:\vcpkg\installed\x64-uwp\bin\icuuc78.dll" "$(OutDir)icuuc78.dll"
      if not exist "$(OutDir)icuin78.dll" copy /Y "C:\vcpkg\installed\x64-uwp\bin\icuin78.dll" "$(OutDir)icuin78.dll"
      if not exist "$(OutDir)icudt78.dll" copy /Y "C:\vcpkg\installed\x64-uwp\bin\icudt78.dll" "$(OutDir)icudt78.dll"
      if not exist "$(OutDir)libEGL.dll" copy /Y "$(ProjectDir)..\angle\x64\libEGL.dll" "$(OutDir)libEGL.dll"
      if not exist "$(OutDir)libGLESv2.dll" copy /Y "$(ProjectDir)..\angle\x64\libGLESv2.dll" "$(OutDir)libGLESv2.dll"
    </PreBuildEvent>
  </PropertyGroup>
  <!-- Loose XBF files: DisableEmbeddedXbf=true → .xbf in intermediate output; copy to appx package payload -->
  <Target Name="InjectXbfForPackaging" AfterTargets="MarkupCompilePass2" BeforeTargets="PrepareForAppxPackage">
    <ItemGroup>
      <XbfToCopy Include="$(IntermediateOutputPath)XamlG\*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(XbfToCopy)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
    <ItemGroup>
      <AppxPackagedFile Include="@(XbfToCopy->'$(OutDir)%(Filename)%(Extension)')" Condition="'%(Extension)'=='.xbf'" />
    </ItemGroup>
  </Target>
  <!-- Apotheosis: fail the build if MainPage.g.hpp has drifted from MainPage.xaml, rather than
       shipping an appx that builds cleanly and then dies at startup. That is not hypothetical: a
       stale Connect() bound x:Name fields to the wrong controls and left ContentArea null in
       0.1.8.64 through 0.1.8.67, and a null ^ handle in C++/CX is an access violation that
       catch (...) cannot catch, so four builds in a row died with an empty LocalState and no WER
       report. The check needs MainPage.g.h, which MarkupCompilePass1 generates, hence the ordering;
       it skips itself if that file is not there yet. See Src\tools\verify-xaml-connect.ps1. -->
  <!-- Apotheosis 2026-08-25: moved from AfterTargets="MarkupCompilePass1" to Pass2. The check reads
       BOTH generated files, and MainPage.g.hpp is written by Pass2, so hooking Pass1 meant the guard
       could run before the file it needs exists and fail the build. That is exactly what happened when
       a Clean removed MainPage.g.hpp: the guard then blocked the very build that would have
       regenerated it. BeforeTargets="ClCompile" is kept as well, so the guard still runs even if the
       Pass2 target name is absent in some SDK, because a silently skipped guard is worse than a noisy
       one. (No double dashes in this comment: they terminate an XML comment early and MSBuild answers
       with MSB4025. That trap has now cost this file three separate edits.) -->
  <Target Name="VerifyXamlConnect" AfterTargets="MarkupCompilePass2" BeforeTargets="ClCompile">
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)..\tools\verify-xaml-connect.ps1&quot;" />
  </Target>
</Project>
