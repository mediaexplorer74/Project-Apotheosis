<Page
    x:Class="Apotheosis.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">

    <Grid x:Name="RootGrid" Background="#FF161618">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Content area -->
        <Grid Grid.Row="0">
            <Border Background="White">
                <Grid x:Name="ContentArea" Background="White"
                      ManipulationMode="TranslateX,TranslateY,TranslateInertia,Scale"
                      IsTapEnabled="True" Tapped="OnPageTapped"
                      ManipulationDelta="OnImageManipDelta"
                      ManipulationCompleted="OnImageManipCompleted">
                    <Image x:Name="RenderImage" Stretch="None" VerticalAlignment="Top" HorizontalAlignment="Left"/>
                </Grid>
            </Border>
            <SwapChainPanel x:Name="GpuPanel" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            IsHitTestVisible="False" Visibility="Collapsed"/>
            <ProgressBar x:Name="Progress" Height="2.5" VerticalAlignment="Top"
                         Foreground="#FF3AA0FF" Background="Transparent"
                         IsIndeterminate="False" Visibility="Collapsed"/>
        </Grid>

        <!-- Bottom chrome: status + URL bar -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#FF2A2A2C">
                <TextBlock x:Name="TitleText" Text="EdgeHTML Reborn"
                           Foreground="#FF9BA0A6" FontSize="11"
                           HorizontalAlignment="Center" Margin="14,3,14,2"
                           TextTrimming="CharacterEllipsis"/>
            </Border>

            <Grid Grid.Row="1" Height="54" Background="#FF2A2A2C"
                  BorderBrush="#22FFFFFF" BorderThickness="0,1,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BackBtn" Grid.Column="0"
                        Background="Transparent" BorderThickness="0"
                        Width="50" Height="54" Padding="0"
                        Foreground="#FFF2F2F3" FontFamily="Segoe MDL2 Assets"
                        FontSize="19" Content="&#xE72B;" Click="OnBack"/>

                <Border Grid.Column="1" Background="#FF1B1B1D" CornerRadius="9"
                        Margin="6,8" Padding="0" Height="38">
                    <TextBox x:Name="UrlBox" FontSize="15" Height="38"
                             BorderThickness="0" Background="Transparent"
                             Foreground="#FFF2F2F3" VerticalAlignment="Center"
                             VerticalContentAlignment="Center" Padding="6,0"
                             InputScope="Url" PlaceholderText="Search or enter URL"
                             KeyDown="OnUrlKeyDown" TextChanged="OnUrlChanged"/>
                </Border>

                <Button x:Name="GoBtn" Grid.Column="2"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#FFF2F2F3" Width="50" Height="54" Padding="0"
                        FontSize="16" Content="&#x21BB;" Click="OnGo"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
