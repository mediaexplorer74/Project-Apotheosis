<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>AppContainerExe</OutputType>
    <TargetFramework>uap10.0.19041</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Apotheosis</RootNamespace>
    <AssemblyName>Apotheosis</AssemblyName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <Platforms>ARM;x64</Platforms>
    <RuntimeIdentifiers>win10-arm;win10-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETCore.UniversalWindowsPlatform" Version="6.2.14" />
  </ItemGroup>
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
    <None Include="Apotheosis_TemporaryKey.pfx" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\Square44x44Logo.png" />
    <Content Include="Assets\Square150x150Logo.png" />
    <Content Include="Assets\SplashScreen.png" />
    <Content Include="Assets\cacert.pem" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\en-US\Resources.resw" />
    <Content Include="Resources\ru-RU\Resources.resw" />
    <Content Include="Resources\zh-Hans\Resources.resw" />
  </ItemGroup>
</Project>
