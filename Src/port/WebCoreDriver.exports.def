; WebCoreDriver.exports.def — the C ABI export surface for the C# UWP harness.
; Build: link with /DEF:WebCoreDriver.exports.def to produce clean DLL exports.
; (This file is the authority on what the DLL exports. A function declared in
;  WebCoreDriver.h and implemented in WebCoreDriver.cpp is NOT reachable from C#
;  unless it is listed below; the failure mode is EntryPointNotFoundException at
;  runtime, not a compile or link error. The header comment used to read "30
;  essential exports"; the list had grown to 37 before the viewport pair below
;  was added, and the stale count is what made a missing name easy to overlook.)
;
; 9 functions removed from export surface:
;   WebCoreRenderHtmlStub   — test stub, never called
;   WebCoreLoadUrl          — replaced by WebCoreSessionLoad (persistent session)
;   WebCoreSetCACertPath    — file-based CA fails in App Container; use Blob variant
;   WebCoreGetPageScale     — scale tracked on harness side (m_pageScale)
;   WebCoreSessionPaint     — superseded by WebCoreLiveTick
;   WebCoreComposite        — GPU direct-present happens inside LiveTick/ClickAt
;   WebCoreCompositeReadback — replaced by GPU direct-present path
;   WebCoreGpuSetFlip       — debug-only, not used
;   WebCoreEvalJS           — JS injection, not needed for browsing

LIBRARY WebCoreDriver
EXPORTS
    ; TLS / CA certificates
    WebCoreSetCACertBlob

    ; Apotheosis: managed-host support (native FONTCONFIG_FILE, opt-in SEH guard, probes)
    WebCoreSetFontConfigFile
    ; M1: file-backed cookie jar. Reached from C# through this list alone, like the line above.
    WebCoreSetCookieJarPath
    ; M2: file-backed localStorage. Same rule: absent from this list, absent from the C# host.
    WebCoreSetLocalStoragePath
    WebCoreSetSehGuard
    WebCoreGetSehInfo
    WebCoreGetFontInfo
    WebCoreDumpFontConfig

    ; Content configuration (JS / images toggles from Settings)
    WebCoreConfigure

    ; One-shot rendering (home page, error pages)
    WebCoreRenderHtml

    ; Persistent session lifecycle
    WebCoreSessionLoad
    WebCoreCloseSession

    ; Interaction
    WebCoreClickAt
    WebCoreScrollBy
    WebCoreScrollByAt
    WebCoreSyncLinks
    WebCoreTypeText
    WebCoreKeyAction
    WebCoreFocusedEditable

    ; Back/forward history of the live session. The engine's own back/forward list, not the host's
    ; _navStack: link clicks, in-page navigations and redirects enter it and the host never sees
    ; them, so a Back driven from the host's stack alone cannot return to where the user came from.
    WebCoreGoBack
    WebCoreGoForward
    WebCoreCanGoBack
    WebCoreCanGoForward
    WebCoreSetPageScale
    WebCoreLiveTick

    ; Viewport / scale — the re-layout pair, distinct from WebCoreSetPageScale above.
    ; WebCoreSessionResize moves the session viewport (the page RE-LAYS OUT at the new
    ; size), and WebCoreSetPageZoom is CSS page zoom (device px per CSS px), which also
    ; re-lays out because the layout width is viewport / zoom. Together they are how the
    ; app fits a page to the window instead of the fixed 720x1080 viewport. Both were
    ; implemented and declared in the header long before this line existed, and the C#
    ; side called them anyway -- every call failed at the P/Invoke boundary.
    WebCoreSessionResize
    WebCoreSetPageZoom
    ; The zoom the NEXT session is built at, read in buildSession before the document exists.
    ; WebCoreSetPageZoom needs a live session and so always lands after the document has parsed.
    WebCoreSetNextSessionZoom

    ; Metadata / diagnostics
    WebCoreGetTitle
    WebCoreGetUrl
    WebCoreTakePopupUrl
    WebCoreGetLinkCount
    WebCoreGetLink
    WebCoreGetFrameHash
    WebCoreGetPendingResourceCount
    WebCoreGetLastError
    WebCoreGetDiag
    WebCoreEditDebug

    ; Find in page
    WebCoreFindString
    WebCoreFindNext
    WebCoreFindClear

    ; Downloads
    WebCoreDownload

    ; User agent
    WebCoreSetUserAgentMobile
    WebCoreSetUserAgentString

    ; GPU compositing
    WebCoreGpuInit
    WebCoreEnableCompositing
    WebCoreGpuLayerInfo
    WebCoreSetGpuInitLogFile

    ; Memory pressure -- frees decoded bitmaps (MemoryCache::pruneLiveResourcesToSize(0,
    ; DestroyDecodedDataForAllLiveResources)) and the resource caches. Listed because the C# line
    ; reaches the driver through THIS file alone: the C++ harness gets the symbol by compiling the
    ; port into Harness.exe, which is not how the app links. Measured 2026-10-03: scrolling dzen.ru
    ; drove the working set 100 -> 298 MB in 47 s and the process was reaped with no dump, and the
    ; one callee known to free decoded bitmaps had no reachable caller from C#.
    WebCoreReleaseMemory
