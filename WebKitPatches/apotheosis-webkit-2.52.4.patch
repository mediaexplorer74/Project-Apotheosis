--- /dev/null
+++ b/Source/WebCore/PlatformWinUWP.cmake
@@ -0,0 +1,145 @@
+# PlatformWinUWP.cmake — Apotheosis: WebCore Cairo platform for UWP
+
+# Include Cairo platform (adds SourcesCairo.txt, cairo includes, Cairo::Cairo lib)
+include(platform/Cairo.cmake)
+
+# Include Curl platform (adds curl sources, ResourceError.h, etc.)
+include(platform/Curl.cmake)
+
+# Apotheosis: PublicSuffixStoreCurl.cpp requires libpsl, which is not available
+# for the UWP App Container. The platform hooks are stubbed in Src/port/stubs-network.cpp.
+list(REMOVE_ITEM WebCore_SOURCES platform/network/curl/PublicSuffixStoreCurl.cpp)
+
+# Adwaita theme (Theme::singleton, RenderTheme::singleton, ControlFactory, etc.)
+include(platform/Adwaita.cmake)
+
+# Win platform directories
+list(APPEND WebCore_PRIVATE_INCLUDE_DIRECTORIES
+    "${WEBCORE_DIR}/accessibility/win"
+    "${WEBCORE_DIR}/page/win"
+    "${WEBCORE_DIR}/platform/win"
+    "${WEBCORE_DIR}/platform/graphics/win"
+    "${WEBCORE_DIR}/platform/graphics/opentype"
+    "${WEBCORE_DIR}/platform/network/win"
+    "${WEBCORE_DIR}/platform/video-codecs"
+    "${WEBCORE_DIR}/platform/image-decoders"
+)
+
+# UWP-safe platform source files (no desktop-only Win32 GDI APIs)
+list(APPEND WebCore_SOURCES
+    platform/generic/KeyedDecoderGeneric.cpp
+    platform/generic/KeyedEncoderGeneric.cpp
+    platform/text/Hyphenation.cpp
+    platform/text/LocaleICU.cpp
+    platform/win/MIMETypeRegistryWin.cpp
+)
+
+# Image decoders - add include dirs and source files manually
+# (ImageDecoders.cmake requires JPEG::JPEG, PNG::PNG, WebP::demux targets from vcpkg)
+list(APPEND WebCore_PRIVATE_INCLUDE_DIRECTORIES
+    "${WEBCORE_DIR}/platform/image-decoders"
+    "${WEBCORE_DIR}/platform/image-decoders/avif"
+    "${WEBCORE_DIR}/platform/image-decoders/bmp"
+    "${WEBCORE_DIR}/platform/image-decoders/gif"
+    "${WEBCORE_DIR}/platform/image-decoders/ico"
+    "${WEBCORE_DIR}/platform/image-decoders/jpeg"
+    "${WEBCORE_DIR}/platform/image-decoders/jpegxl"
+    "${WEBCORE_DIR}/platform/image-decoders/png"
+    "${WEBCORE_DIR}/platform/image-decoders/webp"
+)
+
+list(APPEND WebCore_SOURCES
+    platform/image-decoders/ScalableImageDecoder.cpp
+    platform/image-decoders/ScalableImageDecoderFrame.cpp
+    platform/image-decoders/bmp/BMPImageDecoder.cpp
+    platform/image-decoders/bmp/BMPImageReader.cpp
+    platform/image-decoders/cairo/ImageBackingStoreCairo.cpp
+    platform/image-decoders/gif/GIFImageDecoder.cpp
+    platform/image-decoders/gif/GIFImageReader.cpp
+    platform/image-decoders/ico/ICOImageDecoder.cpp
+    platform/image-decoders/jpeg/JPEGImageDecoder.cpp
+    platform/image-decoders/png/PNGImageDecoder.cpp
+    platform/image-decoders/webp/WEBPImageDecoder.cpp
+)
+
+# Use direct library paths (vcpkg; arch-gated: the x64-uwp line used to be the only
+# consumer, but the ARM line pulls the same deps from arm-uwp. Hardcoding x64-uwp here
+# is what leaked x64 .libs into the ARM link line in the first place.)
+if (CMAKE_SYSTEM_PROCESSOR STREQUAL "ARM")
+    set(_WINUWP_VCPKG_LIB_DIR "C:/vcpkg/installed/arm-uwp/lib")
+else ()
+    set(_WINUWP_VCPKG_LIB_DIR "C:/vcpkg/installed/x64-uwp/lib")
+endif ()
+list(APPEND WebCore_LIBRARIES
+    "${_WINUWP_VCPKG_LIB_DIR}/jpeg.lib"
+    "${_WINUWP_VCPKG_LIB_DIR}/libpng16.lib"
+    "${_WINUWP_VCPKG_LIB_DIR}/libwebp.lib"
+    "${_WINUWP_VCPKG_LIB_DIR}/libwebpdemux.lib"
+    "${_WINUWP_VCPKG_LIB_DIR}/pixman-1.lib"
+    "${_WINUWP_VCPKG_LIB_DIR}/freetype.lib"
+    # Apotheosis 2026-10-23: real SQLite, built from the amalgamation with
+    # SQLITE_OS_WINRT=1 (Src/port/build-sqlite-x64.ps1). The old
+    # stubs-sqlite.cpp returned SQLITE_CANTOPEN for every file database,
+    # which made CookieJarDB (and M1 cookie persistence) impossible.
+    "${_WINUWP_VCPKG_LIB_DIR}/sqlite3.lib"
+)
+
+# WinUWP font stubs (no GDI available in App Container)
+set(APOTHEOSIS_PORT_DIR "${CMAKE_SOURCE_DIR}/../Src/port")
+list(APPEND WebCore_SOURCES
+    "${APOTHEOSIS_PORT_DIR}/stubs-ax.cpp"
+    "${APOTHEOSIS_PORT_DIR}/stubs-crypto.cpp"
+    "${APOTHEOSIS_PORT_DIR}/stubs-font-uwp.cpp"
+    "${APOTHEOSIS_PORT_DIR}/stubs-gdi-uwp.cpp"
+    "${APOTHEOSIS_PORT_DIR}/stubs-loader.cpp"
+    "${APOTHEOSIS_PORT_DIR}/stubs-network.cpp"
+    "${APOTHEOSIS_PORT_DIR}/stubs-other.cpp"
+    "${APOTHEOSIS_PORT_DIR}/stubs-pasteboard.cpp"
+    "${APOTHEOSIS_PORT_DIR}/stubs-screen-uwp.cpp"
+)
+
+# Win Cairo platform sources (no GDI APIs used)
+list(APPEND WebCore_SOURCES
+    platform/graphics/win/FontDescriptionWin.cpp
+)
+
+# Apotheosis: GPU compositing path (TextureMapper + ANGLE/EGL)
+if (USE_TEXTURE_MAPPER)
+    include(platform/TextureMapper.cmake)
+
+    list(APPEND WebCore_PRIVATE_INCLUDE_DIRECTORIES
+        "${WEBCORE_DIR}/platform/graphics/angle"
+        "${WEBCORE_DIR}/platform/graphics/egl"
+        "${WEBCORE_DIR}/platform/graphics/opengl"
+    )
+
+    list(APPEND WebCore_SOURCES
+        platform/graphics/PlatformDisplay.cpp
+        platform/graphics/angle/PlatformDisplayANGLE.cpp
+        platform/graphics/egl/GLContext.cpp
+        platform/graphics/egl/GLContextWrapper.cpp
+        platform/graphics/egl/GLDisplay.cpp
+        platform/graphics/egl/GLFence.cpp
+        platform/graphics/egl/GLFenceEGL.cpp
+        platform/graphics/egl/GLFenceGL.cpp
+        platform/graphics/win/PlatformDisplayWin.cpp
+    )
+endif ()
+
+# Apotheosis: export WebCore internal symbols needed by the port layer.
+# This .def file makes the 11 core WebCore functions (DocumentWriter::begin,
+# EventHandler::handleMouse*, RenderLayerCompositor::frameViewDidScroll,
+# FrameLoader::loadURL/loadWithDocumentLoader/stopAllLoaders,
+# HistoryController::goToItem/restoreScrollPositionAndViewState,
+# FrameSelection::setSelection) available via WebCore.dll's import lib,
+# eliminating the need for WebCoreFull.lib static linking.
+# NOTE: two files, one per arch. MSVC name mangling differs: x64 emits the
+# __cdecl marker (QEAA/AEBV/PEAV), ARM32 clang-cl emits thiscall (QAA/ABV/PAV).
+if (CMAKE_SYSTEM_PROCESSOR STREQUAL "ARM")
+    set(WEBCORE_EXPORT_DEF "${APOTHEOSIS_PORT_DIR}/webcore-exports-arm32.def")
+else ()
+    set(WEBCORE_EXPORT_DEF "${APOTHEOSIS_PORT_DIR}/webcore-exports.def")
+endif ()
+if(EXISTS "${WEBCORE_EXPORT_DEF}")
+    target_link_options(WebCore PRIVATE "/DEF:${WEBCORE_EXPORT_DEF}")
+endif()
