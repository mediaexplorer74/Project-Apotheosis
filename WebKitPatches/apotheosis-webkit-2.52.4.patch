@@ -0,0 +1,2 @@
+# PlatformWinUWP.cmake — Apotheosis: bmalloc for UWP
+# No platform-specific additions needed.
diff --git a/Source/bmalloc/bmalloc/PerThread.h b/Source/bmalloc/bmalloc/PerThread.h
index 2d8a8cb4..3003e0be 100644
--- a/Source/bmalloc/bmalloc/PerThread.h
+++ b/Source/bmalloc/bmalloc/PerThread.h
@@ -48,6 +48,28 @@
 #define HAVE_PTHREAD_MACHDEP_H 0
 #endif
 
+/* Apotheosis: on 32-bit Windows (BENABLE_LIBPAS requires ADDRESS64, so LIBPAS is off here) bmalloc
+   compiles the generic pthread TLS paths, but Windows has no pthread.h. Provide the tiny subset
+   those paths use on top of Win32 TLS. Only active on ARM32 WinUWP; 64-bit Windows uses libpas and
+   never reaches this code. */
+#if BOS(WINDOWS) && !BUSE(LIBPAS) && defined(WK_WINUWP)
+#include <windows.h>
+using pthread_key_t = DWORD;
+static inline int pthread_key_create(pthread_key_t* key, void (*)(void*))
+{
+    *key = TlsAlloc();
+    return (*key == TLS_OUT_OF_INDEXES) ? 1 : 0;
+}
+static inline void* pthread_getspecific(pthread_key_t key)
+{
+    return TlsGetValue(key);
+}
+static inline int pthread_setspecific(pthread_key_t key, const void* value)
+{
+    return TlsSetValue(key, const_cast<void*>(value)) ? 0 : 1;
+}
+#endif
+
 #if !BUSE(LIBPAS)
 
 namespace bmalloc {
diff --git a/Source/bmalloc/bmalloc/VMAllocate.h b/Source/bmalloc/bmalloc/VMAllocate.h
index f16990d8..ff847017 100644
--- a/Source/bmalloc/bmalloc/VMAllocate.h
+++ b/Source/bmalloc/bmalloc/VMAllocate.h
@@ -364,7 +364,17 @@ inline void* tryVMAllocate(size_t vmSize, VMTag usage)
     BUNUSED_PARAM(usage);
     const bool writable = true;
     const bool executable = true;
+#if defined(WK_WINUWP)
+    // Apotheosis: VirtualAllocFromApp on Windows 10 Mobile (15254) rejects direct
+    // PAGE_EXECUTE_READWRITE allocation (err=87 ERROR_INVALID_PARAMETER) but accepts
+    // writable memory; executable pages are made later via VirtualProtectFromApp
+    // (W^X flip). Proven on-device by the harness JIT probe: scenarios [A] RW->RX
+    // and [C] RW->RWX succeed, direct RWX alloc fails. The bmalloc heap only needs
+    // writable pages, so allocate them non-executable.
+    return VirtualAllocFromApp(nullptr, vmSize, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+#else
     return VirtualAlloc(nullptr, vmSize, MEM_RESERVE, protection(writable, executable));
+#endif
 }
 
