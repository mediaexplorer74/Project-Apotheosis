 #if !defined(NDEBUG) || !(OS(DARWIN) || PLATFORM(PLAYSTATION))
+#if defined(WK_WINUWP)
+// Apotheosis: name the caller before the stomp.
+//
+// Deaths on the device keep arriving with no UEF line, no dump, and a heartbeat that keeps
+// beating -- while every hypothesis about WHERE the engine dies keeps dying instead. On this
+// kernel+SDK the 0xbbadbeef stomp plus __builtin_trap() below evidently fails to surface through
+// the unhandled-exception filter (the filter catches ordinary AVs fine -- StringImpl derefs were
+// caught and logged), so WTFCrash-family deaths have been invisible. This hook makes them
+// impossible to miss: one backtrace into port-trace.txt (same FONTCONFIG_FILE channel as every
+// other Apotheosis probe), flushed BEFORE the stomp, symbolisable offline against the module
+// bases the harness logs at startup.
+static void apoCrashTrace()
+{
+    void* bt[20];
+    USHORT n = RtlCaptureStackBackTrace(0, 20, bt, nullptr);
+    const char* fontConfigFile = getenv("FONTCONFIG_FILE");
+    if (!fontConfigFile)
+        return;
+    std::string path(fontConfigFile);
+    auto pos = path.rfind('\\');
+    if (pos == std::string::npos)
+        return;
+    path.resize(pos + 1);
+    path += "port-trace.txt";
+    FILE* f = fopen(path.c_str(), "ab");
+    if (!f)
+        return;
+    fprintf(f, "wtfcash: begin tid=%lu frames=%u\n", GetCurrentThreadId(), (unsigned)n);
+    for (USHORT i = 0; i < n; ++i)
+        fprintf(f, "  #%u %p\n", i, bt[i]);
+    fprintf(f, "wtfcash: end\n");
+    fflush(f);
+    fclose(f);
+}
+#endif
+
 void WTFCrash()
 {
+#if defined(WK_WINUWP)
+    apoCrashTrace();
+#endif
