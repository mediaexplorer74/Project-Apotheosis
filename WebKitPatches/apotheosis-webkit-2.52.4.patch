diff --git a/Source/cmake/OptionsWinUWP.cmake b/Source/cmake/OptionsWinUWP.cmake
new file mode 100644
index 00000000..dac5e1fc
--- /dev/null
+++ b/Source/cmake/OptionsWinUWP.cmake
@@ -0,0 +1,307 @@
+# OptionsWinUWP.cmake — Apotheosis: WebKit port for Windows 10 Mobile / UWP App Container
+# Based on OptionsWin.cmake, adapted for UWP (WK_WINUWP=1).
+
+include(OptionsMSVC)
+
+set(PROJECT_VERSION_MAJOR 1)
+set(PROJECT_VERSION_MINOR 0)
+set(PROJECT_VERSION_MICRO 0)
+set(PROJECT_VERSION ${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}.${PROJECT_VERSION_MICRO})
+
+# UWP App Container defines
+add_definitions(-D_WINDOWS -DNTDDI_VERSION=0x0A000006 -D_WIN32_WINNT=0x0A00)
+add_definitions(-DNOMINMAX -DUNICODE -D_UNICODE -DNOCRYPT)
+add_definitions(-D_CRT_NONSTDC_NO_DEPRECATE)
+add_definitions(-D_SILENCE_CXX23_DENORM_DEPRECATION_WARNING)
+add_definitions(-D_WINSOCKAPI_=)
+
+# Apotheosis: UWP guard
+add_definitions(-DWK_WINUWP=1)
+
+# Cairo is a static library — avoid __declspec(dllimport) decoration
+# (cairo.h checks CAIRO_WIN32_STATIC_BUILD, not CAIRO_STATIC, on Windows)
+add_definitions(-DCAIRO_WIN32_STATIC_BUILD=1)
+
+# Disable exceptions (clang thumbv7-windows-msvc cannot lower cleanupret)
+add_definitions(-D_HAS_EXCEPTIONS=0)
+
+# Apotheosis: UWP App Container compatibility
+add_definitions(-Dgetpid=GetCurrentProcessId)
+
+set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY_DEBUG "${CMAKE_ARCHIVE_OUTPUT_DIRECTORY}")
+set(CMAKE_ARCHIVE_OUTPUT_DIRECTORY_RELEASE "${CMAKE_ARCHIVE_OUTPUT_DIRECTORY}")
+set(CMAKE_LIBRARY_OUTPUT_DIRECTORY_DEBUG "${CMAKE_LIBRARY_OUTPUT_DIRECTORY}")
+set(CMAKE_LIBRARY_OUTPUT_DIRECTORY_RELEASE "${CMAKE_LIBRARY_OUTPUT_DIRECTORY}")
+set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_DEBUG "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}")
+set(CMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE "${CMAKE_RUNTIME_OUTPUT_DIRECTORY}")
+
+set(CMAKE_DISABLE_PRECOMPILE_HEADERS OFF)
+
+# Apotheosis: Find ICU from custom build path
+find_package(ICU 70.1 REQUIRED COMPONENTS data i18n uc)
+
+# Apotheosis: create ANGLE imported targets from pre-built binaries.
+# The tracked ARM binaries live in Src\angle\arm, the x64 ones came from NuGet.
+if (CMAKE_SYSTEM_PROCESSOR STREQUAL "ARM")
+    set(_ANGLE_DIR "${CMAKE_SOURCE_DIR}/../Src/angle/arm")
+else ()
+    set(_ANGLE_DIR "${CMAKE_SOURCE_DIR}/../Src/angle/x64")
+endif ()
+set(_ANGLE_INCLUDE "${CMAKE_SOURCE_DIR}/../Src/angle/include")
+if (EXISTS "${_ANGLE_DIR}/libEGL.lib")
+    add_library(ANGLE::EGL SHARED IMPORTED)
+    set_target_properties(ANGLE::EGL PROPERTIES
+        IMPORTED_LOCATION "${_ANGLE_DIR}/libEGL.dll"
+        IMPORTED_IMPLIB "${_ANGLE_DIR}/libEGL.lib"
+        INTERFACE_INCLUDE_DIRECTORIES "${_ANGLE_INCLUDE}"
+    )
+    add_library(ANGLE::GLES SHARED IMPORTED)
+    set_target_properties(ANGLE::GLES PROPERTIES
+        IMPORTED_LOCATION "${_ANGLE_DIR}/libGLESv2.dll"
+        IMPORTED_IMPLIB "${_ANGLE_DIR}/libGLESv2.lib"
+        INTERFACE_INCLUDE_DIRECTORIES "${_ANGLE_INCLUDE}"
+    )
+    # Apotheosis: alias OpenGL::GLES -> ANGLE::GLES for WebCore CMakeLists.txt
+    add_library(OpenGL::GLES ALIAS ANGLE::GLES)
+endif ()
+
+# Apotheosis: Find packages from vcpkg x64-uwp
+find_package(CURL)
+# Apotheosis: the architecture gate is BACK, and this time the comment matches the code.
+#
+# It was removed earlier on 2026-08-22 on the reasoning that once x64 also had harfbuzz-icu the gate
+# had no purpose -- both lines could simply ask for `COMPONENTS ICU`. The reasoning was fine and the
+# consequence was not: editing this file makes ninja re-run CMake, and **the ARM build directory
+# cannot survive a reconfigure**. Its working build.ninja predates the 2026-08-18 switch to static
+# Cairo, so regenerating it resurrects the shared-Cairo branch below: WebCore.dll then links
+# arm-uwp/lib/cairo.lib (the import lib for cairo-2.dll) and pulls user32/gdi32/msimg32 into the link,
+# which collides with the port's own GDI stubs -- 20 duplicate symbols -- and, worse, would have
+# produced a WebCore.dll importing a DLL that cannot load on Windows 10 Mobile at all.
+#
+# So the gate stays until the ARM tree can be reconfigured safely, which is its own task. What was
+# actually wrong here was only the comment: it claimed the gate existed because x64 lacked the ICU
+# component, when in truth ARM is the line that needs the plain lookup, because the block further
+# down hand-builds HarfBuzz::HarfBuzz for it and sets HarfBuzz_FOUND itself.
+if (CMAKE_SYSTEM_PROCESSOR STREQUAL "ARM")
+    find_package(HarfBuzz)
+else ()
+    find_package(HarfBuzz COMPONENTS ICU)
+endif ()
+find_package(JPEG)
+find_package(LibXml2 REQUIRED)
+find_package(OpenSSL)
+find_package(PNG REQUIRED)
+# Apotheosis: Use our compiled static SQLite3 lib (SQLITE_OS_WINRT=1) instead of icu's import lib.
+# ARM: built by Src\port\build-sqlite-arm32.ps1 from the amalgamation; the vcpkg sqlite3 port
+# cannot build for arm-uwp at all (modern amalgamations have no WinRT code path).
+if (CMAKE_SYSTEM_PROCESSOR STREQUAL "ARM")
+    set(_SQLITE3_LIB "C:/vcpkg/installed/arm-uwp/lib/sqlite3.lib")
+else ()
+    set(_SQLITE3_LIB "${CMAKE_SOURCE_DIR}/../build-x64-gpu/libs/sqlite3.lib")
+endif ()
+if (EXISTS "${_SQLITE3_LIB}")
+    set(SQLite3_LIBRARY "${_SQLITE3_LIB}" CACHE FILEPATH "SQLite3 static library" FORCE)
+endif ()
+find_package(SQLite3)
+find_package(ZLIB REQUIRED)
+
+# Apotheosis: CURL not found for x64-uwp, create target from x64-windows
+if (NOT TARGET CURL::libcurl)
+    set(_CURL_DIR "C:/vcpkg/installed/x64-windows")
+    if (EXISTS "${_CURL_DIR}/lib/libcurl.lib")
+        add_library(CURL::libcurl SHARED IMPORTED)
+        set_target_properties(CURL::libcurl PROPERTIES
+            IMPORTED_LOCATION "${_CURL_DIR}/bin/libcurl.dll"
+            IMPORTED_IMPLIB "${_CURL_DIR}/lib/libcurl.lib"
+            INTERFACE_INCLUDE_DIRECTORIES "${_CURL_DIR}/include"
+        )
+    endif ()
+endif ()
+
+# Apotheosis: Cairo from manual build.
+# ARM: meson-built DLL stack in C:\vcpkg\installed\arm-uwp (Doc/ARM32-BUILD-GUIDE.md section 3).
+# The meson install ships import libs only, so WebCore must take the __imp_ thunks: do NOT set
+# CAIRO_WIN32_STATIC_BUILD here, or WebCore's direct cairo_* calls will be undefined at link time.
+if (CMAKE_SYSTEM_PROCESSOR STREQUAL "ARM")
+    set(_CAIRO_LIB "C:/vcpkg/installed/arm-uwp/lib/cairo.lib")
+    if (EXISTS "${_CAIRO_LIB}")
+        add_library(Cairo::Cairo SHARED IMPORTED)
+        set_target_properties(Cairo::Cairo PROPERTIES
+            IMPORTED_LOCATION "C:/vcpkg/installed/arm-uwp/bin/cairo-2.dll"
+            IMPORTED_IMPLIB "${_CAIRO_LIB}"
+            INTERFACE_INCLUDE_DIRECTORIES "C:/vcpkg/installed/arm-uwp/include;C:/vcpkg/installed/arm-uwp/include/cairo;C:/vcpkg/installed/arm-uwp/include/harfbuzz"
+            INTERFACE_LINK_LIBRARIES "C:/vcpkg/installed/arm-uwp/lib/pixman-1.lib;C:/vcpkg/installed/arm-uwp/lib/freetype.lib;C:/vcpkg/installed/arm-uwp/lib/harfbuzz.lib;C:/vcpkg/installed/arm-uwp/lib/harfbuzz-icu.lib;C:/vcpkg/installed/arm-uwp/lib/fontconfig.lib;C:/vcpkg/installed/arm-uwp/lib/libexpat.lib")
+    # Apotheosis 2026-08-22: user32.lib, gdi32.lib and msimg32.lib were removed from the interface
+    # above. They are wrong for this port and had never actually been linked: the WebCore.dll that runs
+    # on the device (built 2026-08-19, before this file drifted ahead of the build directory) links
+    # exactly 24 libraries and none of those three. Regenerating build.ninja added them and the link
+    # died on 20 duplicate symbols --
+    #     lld-link: error: duplicate symbol: DeleteObject
+    #     >>> defined at Src\port\stubs-gdi-uwp.cpp:33
+    #     >>> defined at gdi32.lib(GDI32.dll)
+    # -- which is the port telling us what it already knew: an App Container cannot use desktop GDI,
+    # so stubs-gdi-uwp.cpp supplies DeleteObject, GetGlyphOutlineW, SaveDC and the rest itself. Linking
+    # the real gdi32 both collides with those and would bind an import the Lumia cannot satisfy.
+    endif ()
+    if (NOT TARGET HarfBuzz::HarfBuzz)
+        # Apotheosis: meson harfbuzz installs no CMake config; find_package(HarfBuzz) fails on ARM,
+        # so create the imported target here (ICU linkage rides on Cairo::Cairo's interface above).
+        add_library(HarfBuzz::HarfBuzz SHARED IMPORTED)
+        set_target_properties(HarfBuzz::HarfBuzz PROPERTIES
+            IMPORTED_LOCATION "C:/vcpkg/installed/arm-uwp/bin/harfbuzz.dll"
+            IMPORTED_IMPLIB "C:/vcpkg/installed/arm-uwp/lib/harfbuzz.lib"
+            INTERFACE_INCLUDE_DIRECTORIES "C:/vcpkg/installed/arm-uwp/include/harfbuzz")
+    endif ()
+    set(HarfBuzz_FOUND TRUE)
+endif ()
+if (NOT TARGET Cairo::Cairo)
+    # Complete static library compiled from all cairo-1.18.4 .c files (x64 line)
+    set(_CAIRO_LIBS_DIR "${CMAKE_SOURCE_DIR}/../build-x64-gpu/libs")
+    set(_CAIRO_COMPLETE "${_CAIRO_LIBS_DIR}/cairo-complete-x64-uwp.lib")
+    set(_CAIRO_INC "${_CAIRO_LIBS_DIR}/cairo-src/cairo-1.18.4/src")
+    if (EXISTS "${_CAIRO_COMPLETE}")
+        set(_PIXMAN_LIB "C:/vcpkg/installed/x64-uwp/lib/pixman-1.lib")
+        set(_PNG_LIB "C:/vcpkg/installed/x64-uwp/lib/libpng16.lib")
+        # Apotheosis 2026-08-21: HarfBuzz rides on Cairo's interface here, exactly as it does in the
+        # ARM branch above. It is not elegant and it is not where a newcomer would look, but the
+        # alternative is worse: meson's harfbuzz installs no CMake package config, so
+        # find_package(HarfBuzz) yields no usable imported target for the WinUWP port, and nothing
+        # else in this port links HarfBuzz explicitly.
+        #
+        # This became necessary the moment USE_HARFBUZZ turned on for x64. Before that the include
+        # directory was simply never needed, so its absence was invisible; the first symptom was
+        #   platform/text/LocaleICU.cpp(46,10): fatal error: 'hb-icu.h' file not found
+        # even though the header sits in C:/vcpkg/installed/x64-uwp/include/harfbuzz and
+        # find_package had reported "Found HarfBuzz ... version 14.3.0". Found is not the same as
+        # reachable.
+        set(_HB_INC "C:/vcpkg/installed/x64-uwp/include/harfbuzz")
+        set(_HB_LIB "C:/vcpkg/installed/x64-uwp/lib/harfbuzz.lib")
+        set(_HB_ICU_LIB "C:/vcpkg/installed/x64-uwp/lib/harfbuzz-icu.lib")
+        add_library(Cairo::Cairo STATIC IMPORTED)
+        set_target_properties(Cairo::Cairo PROPERTIES
+            IMPORTED_LOCATION "${_CAIRO_COMPLETE}"
+            INTERFACE_INCLUDE_DIRECTORIES "${_CAIRO_INC};${_HB_INC}"
+            INTERFACE_COMPILE_DEFINITIONS "CAIRO_WIN32_STATIC_BUILD"
+            INTERFACE_LINK_LIBRARIES "${_PIXMAN_LIB};${_PNG_LIB};${_HB_LIB};${_HB_ICU_LIB}"
+        )
+    else ()
+        # Fallback: use icu's cairo.lib + missing symbols lib
+        set(_CAIRO_LIB "C:/icu-x64-uwp/lib/cairo.lib")
+        set(_CAIRO_MISSING "${_CAIRO_LIBS_DIR}/cairo-missing-x64-uwp.lib")
+        set(_CAIRO_INC "C:/icu-x64-uwp/include")
+        if (EXISTS "${_CAIRO_LIB}")
+            add_library(Cairo::Cairo STATIC IMPORTED)
+            set_target_properties(Cairo::Cairo PROPERTIES
+                IMPORTED_LOCATION "${_CAIRO_LIB}"
+                INTERFACE_INCLUDE_DIRECTORIES "${_CAIRO_INC}"
+                INTERFACE_COMPILE_DEFINITIONS "CAIRO_WIN32_STATIC_BUILD"
+            )
+            if (EXISTS "${_CAIRO_MISSING}")
+                set_property(TARGET Cairo::Cairo APPEND PROPERTY
+                    INTERFACE_LINK_LIBRARIES "${_CAIRO_MISSING}")
+            endif ()
+        endif ()
+    endif ()
+endif ()
+
+# Apotheosis: LibPSL stub (not available for x64-uwp)
+if (NOT TARGET LibPSL::LibPSL)
+    add_library(LibPSL::LibPSL INTERFACE IMPORTED)
+endif ()
+
+# Apotheosis: SQLite3 stub fallback (should not be needed with static build)
+if (NOT TARGET SQLite3::SQLite3)
+    add_library(SQLite3::SQLite3 INTERFACE IMPORTED)
+endif ()
+
+# Apotheosis: OpenGL::GLES fallback (if ANGLE not found, provide stub)
+if (NOT TARGET OpenGL::GLES)
+    add_library(OpenGL::GLES INTERFACE IMPORTED)
+endif ()
+
+# Apotheosis: OpenSSL stub (not built for x64-uwp yet)
+if (NOT TARGET OpenSSL::SSL)
+    add_library(OpenSSL::SSL INTERFACE IMPORTED)
+endif ()
+if (NOT TARGET OpenSSL::Crypto)
+    add_library(OpenSSL::Crypto INTERFACE IMPORTED)
+endif ()
+
+# Apotheosis: force generic event loop (no HWND messaging in UWP App Container)
+SET_AND_EXPOSE_TO_BUILD(USE_GENERIC_EVENT_LOOP 1)
+SET_AND_EXPOSE_TO_BUILD(WTF_DEFAULT_EVENT_LOOP 0)
+add_definitions(-DUSE_GENERIC_EVENT_LOOP=1 -DWTF_DEFAULT_EVENT_LOOP=0)
+
+WEBKIT_OPTION_BEGIN()
+
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_API_TESTS PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_ATTACHMENT_ELEMENT PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_CURSOR_VISIBILITY PUBLIC ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_DEVICE_ORIENTATION PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_DRAG_SUPPORT PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_FTL_JIT PUBLIC ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_FULLSCREEN_API PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_GAMEPAD PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_GEOLOCATION PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_LAYOUT_TESTS PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MATHML PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MEDIA_SOURCE PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MEDIA_STATISTICS PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MINIBROWSER PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_MOUSE_CURSOR_SCALE PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_PERIODIC_MEMORY_MONITOR PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_VIDEO PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBASSEMBLY PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBASSEMBLY_BBQJIT PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBASSEMBLY_OMGJIT PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBKIT_OVERFLOW_SCROLLING_CSS_PROPERTY PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEB_AUDIO PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_XSLT PUBLIC OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_SMOOTH_SCROLLING PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBGL PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_AVIF PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_SKIA PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_WOFF2 PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_SYSTEM_MALLOC PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_DARK_MODE_CSS PRIVATE OFF)
