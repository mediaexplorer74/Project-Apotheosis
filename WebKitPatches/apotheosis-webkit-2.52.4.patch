diff --git a/Source/WTF/wtf/text/StringImpl.cpp b/Source/WTF/wtf/text/StringImpl.cpp
index cbe3ff0a..f4f479a9 100644
--- a/Source/WTF/wtf/text/StringImpl.cpp
+++ b/Source/WTF/wtf/text/StringImpl.cpp
@@ -802,8 +802,85 @@ SlowPath:
     return newImpl;
 }
 
+#if defined(WK_WINUWP)
+// Apotheosis: device-only instrumentation. Appends to the harness's port-trace.txt (path derived
+// from FONTCONFIG_FILE, which the harness sets) so the input of convertToASCIILowercase can be
+// inspected on the Lumia, where there is no debugger.
+//
+// This probe used to be the crash. It read word 0 of the StringImpl, cast it to a pointer and
+// dereferenced it as UTF-16 -- but word 0 is m_refCount, not a pointer, so for any static string
+// (refcount 1) that dereferenced address 0x00000001. On the device that produced exactly the failure
+// it was meant to explain: 0xC0000005 at StringImpl.cpp:829 inside apoTraceLowercaseInput, reached
+// from convertToASCIILowercase. Symbolising the ARM32 PDB is what showed the probe, rather than the
+// engine, was faulting.
+//
+// The rewrite keeps the useful part and inverts the order so that a bad `impl` can no longer hide
+// the answer:
+//   1. the caller's return address goes out FIRST and is flushed, because "who called this with a
+//      broken StringImpl" is the actual open question, and that line survives even if every
+//      subsequent read faults;
+//   2. `impl` is then sanity-checked before being touched at all;
+//   3. the four header words are dumped as integers, never as pointers;
+//   4. length/flags come last, since those go through StringImpl's accessors.
+// Each step is flushed separately, so whichever line is missing from port-trace.txt names the step
+// that died.
+static void apoTraceLowercaseInput(const StringImpl* impl)
+{
+    const char* fcc = getenv("FONTCONFIG_FILE");
+    if (!fcc)
+        return;
+    std::string path(fcc);
+    auto pos = path.rfind('\\');
+    if (pos == std::string::npos)
+        return;
+    path.resize(pos + 1);
+    path += "port-trace.txt";
+    FILE* f = fopen(path.c_str(), "ab");
+    if (!f)
+        return;
+
+    fprintf(f, "APOTRACE lower: caller=%p impl=%p\n", __builtin_return_address(0), impl);
+    fflush(f);
+
+    // A StringImpl is at least 4-byte aligned and never lives in the bottom 64 KB. Anything else is
+    // not a StringImpl, and saying so is more useful than faulting while proving it.
+    const uintptr_t addr = reinterpret_cast<uintptr_t>(impl);
+    if (!impl || (addr & 3) || addr < 0x10000) {
+        fprintf(f, "APOTRACE lower: impl is not a usable pointer, stopping here\n");
+        fflush(f);
+        fclose(f);
+        return;
+    }
+
+    const unsigned* words = reinterpret_cast<const unsigned*>(impl);
+    fprintf(f, "APOTRACE lower: words=%08x %08x %08x %08x\n", words[0], words[1], words[2], words[3]);
+    fflush(f);
+
+    const unsigned len = impl->length();
+    const int is8 = impl->is8Bit() ? 1 : 0;
+    fprintf(f, "APOTRACE lower: len=%u is8bit=%d\n", len, is8);
+    fflush(f);
+
+    // Only now, and only when the length is credible, look at the characters. The original device
+    // crash was reported as a 16-bit string claiming roughly 1.2 GB, so an implausible length is the
+    // symptom to record rather than a reason to read that far.
+    if (len && len < 4096) {
+        const void* data = is8 ? static_cast<const void*>(impl->span8().data())
+                               : static_cast<const void*>(impl->span16().data());
+        fprintf(f, "APOTRACE lower: data=%p first=%.16s\n", data,
+            is8 ? reinterpret_cast<const char*>(data) : "(16-bit)");
+    } else
+        fprintf(f, "APOTRACE lower: length %u is implausible, characters not read\n", len);
+    fflush(f);
+    fclose(f);
+}
+#endif
+
 Ref<StringImpl> StringImpl::convertToASCIILowercase()
 {
+#if defined(WK_WINUWP)
+    apoTraceLowercaseInput(this);
+#endif
     if (is8Bit())
         return convertASCIICase<CaseConvertType::Lower>(*this, span8());
     return convertASCIICase<CaseConvertType::Lower>(*this, span16());
