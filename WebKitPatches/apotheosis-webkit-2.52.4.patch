+
+// Apotheosis 2026-09-24: one shared sink for the loader's own diagnostics, because the two places
+// that have to be traced sit in two translation units -- platform/network/ResourceHandle.cpp, which
+// knows whether a transfer ever reached a terminal callback, and loader/SubresourceLoader.cpp,
+// which knows what the engine did with it -- and neither can reach the port's
+// `WebCorePort::portDiagLog`. That one is defined in WebCoreDriver.cpp and linked into Harness.exe,
+// while both of these are compiled into WebCore.dll: a call across that boundary is an unresolved
+// external rather than a diagnostic. `WTFLogAlways` is not an option either -- on this port it
+// sinks to OutputDebugStringA and never reaches a file (WTF/wtf/Assertions.cpp).
+//
+// Why a shared header rather than a copy in each file: the leaf-name formatting and the arm-file
+// resolution must agree exactly between the two, or the two traces cannot be paired, and a copy is
+// how they stop agreeing. Nothing else includes this header, so it dirties only these two unified
+// sources -- unlike anything placed in a widely-included WebCore header, which was measured on
+// 2026-09-18 to cost all 362 of them (Doc/CALC-HANDLE-DANGLING.md §6.2).
+//
+// Arming: the sink derives its own path from APOTHEOSIS_GLYPH_LOG's directory (the harness exports
+// that one unconditionally, MainPage.xaml.cpp), appends to `rh-trace.log` beside it, and runs only
+// while `rh-trace.txt` exists in that same directory. A file and not an environment variable,
+// because the bench activates the app through `shell:AppsFolder\...` and the app never sees the
+// PowerShell session's environment. Cost with the arm file absent: one getenv and one failed fopen,
+// once per process, on the first call.
+//
+// The trace is deliberately NOT throttled per occurrence the way `ofd:`/`fset:` are: it exists to
+// answer a question about individual resources, and a rate limit would answer it for the wrong
+// ones. Volume is bounded by the number of loads on a page (~130 for lenta.ru), not by glyphs.
+
+#pragma once
+
+#if defined(WK_WINUWP)
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <wtf/URL.h>
+#include <wtf/text/CString.h>
+
+namespace WebCore {
+
+inline const char* apoLoaderTracePath()
+{
+    static const std::string s_path = []() -> std::string {
+        const char* glyph = getenv("APOTHEOSIS_GLYPH_LOG");
+        if (!glyph || !*glyph)
+            return { };
+        std::string dir(glyph);
+        auto slash = dir.find_last_of("\\/");
+        if (slash == std::string::npos)
+            return { };
+        dir.resize(slash + 1);
+        if (FILE* arm = fopen((dir + "rh-trace.txt").c_str(), "rb")) {
+            fclose(arm);
+            return dir + "rh-trace.log";
+        }
+        return { };
+    }();
+    return s_path.empty() ? nullptr : s_path.c_str();
+}
+
+// The attribute is on a declaration so the compiler checks every call site; without it clang emits
+// -Wmissing-format-attribute at each use, which is noise in an upstream file.
+[[gnu::format(printf, 1, 2)]] inline void apoLoaderTrace(const char* fmt, ...);
+inline void apoLoaderTrace(const char* fmt, ...)
+{
+    const char* path = apoLoaderTracePath();
+    if (!path)
+        return;
+    char buf[400];
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(buf, sizeof buf, fmt, ap);
+    va_end(ap);
+    if (FILE* f = fopen(path, "a")) {
+        fputs(buf, f);
+        size_t len = strlen(buf);
+        if (!len || buf[len - 1] != '\n')
+            fputc('\n', f);
+        fclose(f);
+    }
+}
+
+// The loader's own key, computed exactly the way the port's `loader: +` line computes it --
+// everything after the last '/' of the full URL string, capped at 44 characters (`%.44s`).
+// Deliberately identical character for character, so an `RH:`/`SL:` line and a `loader:` line pair
+// without a lookup table, in either direction.
+inline CString apoLoaderLeaf(const URL& url)
+{
+    CString u = url.string().utf8();
+    const char* full = u.data() ? u.data() : "";
+    const char* slash = std::strrchr(full, '/');
+    const char* leaf = (slash && slash[1]) ? slash + 1 : (full[0] ? full : "(empty)");
+    char capped[48];
+    std::snprintf(capped, sizeof capped, "%.44s", leaf);
+    return CString(capped);
+}
+
+} // namespace WebCore
+
+#endif // defined(WK_WINUWP)
