+#if defined(WK_WINUWP)
+
+// Apotheosis: a real ResourceHandle for the curl port.
+//
+// Upstream leaves every member below as ASSERT_NOT_REACHED() under USE(CURL) (see the #else
+// branch), because the curl port loads through the NetworkProcess -- NetworkDataTaskCurl drives
+// CurlRequest directly and ResourceHandle is dead code there. This port has no NetworkProcess:
+// WebCore runs in-process, so ResourceLoader::start() -> ResourceHandle::create() IS the loading
+// path for every subresource.
+//
+// With the upstream bodies in place the failure was completely silent, because in a release build
+// ASSERT_NOT_REACHED() compiles to nothing: start() returned false, create() returned nullptr,
+// ResourceLoader::m_handle stayed null, and the load neither ran nor failed nor got cancelled.
+// Every subresource of every page therefore sat at CachedResource::Pending forever; a pending
+// render-blocking stylesheet keeps Document holding VisualUpdatesPreventedReason::RenderBlocking;
+// and while any such reason is held RenderLayer::shouldSuppressPaintingLayer() refuses to paint
+// anything at all. The result was a blank window on every real site, with a correct title, a
+// correct layout, no error and nothing in any log -- the driver fetches the main document itself
+// with curl, so only the *inside* of the page was dead.
+//
+// What follows is a small in-process equivalent of NetworkDataTaskCurl: it drives
+// WebCore::CurlRequest (already compiled into this build) and forwards its callbacks to the
+// ResourceHandleClient, which in practice is the SubresourceLoader that asked for the load.
+// Cookies need no work here: CurlContext enables libcurl's own in-memory cookie engine
+// (CURLOPT_COOKIEFILE with a null path) and shares it across handles via CURLSHOPT_SHARE.
+
+// Apotheosis 2026-09-24: the WebCore-side terminal-callback trace, and why it has to live here
+// rather than in the port layer.
+//
+// `PortLoaderStrategy` (Src\port\PortPlatformStrategies.cpp) sees a load *start* and a load
+// *retire*, and neither of those distinguishes completed from cancelled. So a run of resources
+// that sit at `CachedResource::Pending` forever while the loader is fully drained -- the lenta.ru
+// case, `pending=32 rs=I` with `inflight=0 pending=0 hosts=0`, `STILL OPEN: 0`, and the
+// `loader: STALL-CEILING` line never firing -- is invisible to every marker the port owns. This
+// file is the only place in the process that knows which terminal callback a given ResourceHandle
+// actually received, and whether it received one at all. The sink itself is shared with
+// loader/SubresourceLoader.cpp and lives in ApoLoaderTrace.h, with the channel's reasoning.
+//
+// Measured with it, on lenta.ru, 0.1.10.58: every one of the 32 Pending resources traces
+// `start,resp,done`, and `DETACH-BEFORE-TERMINAL`/`CANCEL` never fire at all. So the terminal
+// callback WAS delivered to the ResourceHandleClient and the resource stayed Loading anyway -- the
+// loss is strictly above this class, in SubresourceLoader's own state machine. That is why
+// SubresourceLoader.cpp carries the second half of the trace below.
+
+namespace {
+
+class PortCurlLoad final : public RefCounted<PortCurlLoad>, public CurlRequestClient {
+public:
+    static Ref<PortCurlLoad> create(ResourceHandle& handle, ResourceRequest&& request)
+    {
+        return adoptRef(*new PortCurlLoad(handle, WTF::move(request)));
+    }
+
+    void ref() const final { RefCounted<PortCurlLoad>::ref(); }
+    void deref() const final { RefCounted<PortCurlLoad>::deref(); }
+
+    void start()
+    {
+        ASSERT(isMainThread());
+
+        m_curlRequest = CurlRequest::create(m_request, *this);
+        // CurlRequest::resume() is its start: it hands the transfer to CurlContext's scheduler
+        // thread, which calls us back on the main thread (CurlRequest::runOnMainThread). The
+        // engine thread is this port's main thread and pumps that run loop, so the callbacks
+        // below all arrive there.
+        m_curlRequest->resume();
+    }
+
+    // Apotheosis: detach from both sides -- no further client callbacks, and curl stops
+    // transferring. Idempotent, because ResourceHandle::cancel() and ~ResourceHandle() can both
+    // reach it for the same load.
+    void detach()
+    {
+        ASSERT(isMainThread());
+
+        // Apotheosis 2026-09-24: the decisive line of the lenta.ru `pending=22` investigation. A
+        // detach that happens BEFORE any terminal callback is a load torn down while the engine was
+        // still waiting on it -- `ResourceHandle::cancel()` (a ResourceLoader cancel, a
+        // stopAllLoaders, session teardown), ~ResourceHandle, or a response arriving with the client
+        // already gone. The scheduler retires such a load exactly like a completed one: same
+        // `loader: -` line, same drained queue, `STILL OPEN: 0`. So nothing the port traces can tell
+        // the two apart, and the CachedResource that asked for it stays Pending forever -- which is
+        // the whole defect. `client=`/`handle=` separate "the client walked away" from "we were
+        // cancelled under it".
+        if (!m_reportedTerminal) {
+            apoLoaderTrace("RH: DETACH-BEFORE-TERMINAL %s client=%d handle=%d", apoLoaderLeaf(m_request.url()).data(),
+                this->client() ? 1 : 0, m_handle ? 1 : 0);
+            m_reportedTerminal = true;
+        }
+
+        m_handle = nullptr;
+        stopTransfer();
+    }
+
+private:
+    PortCurlLoad(ResourceHandle& handle, ResourceRequest&& request)
+        : m_handle(&handle)
+        , m_request(WTF::move(request))
+    {
+    }
+
+    ResourceHandleClient* client() const { return m_handle ? m_handle->client() : nullptr; }
+
+    void stopTransfer()
+    {
+        if (RefPtr curlRequest = std::exchange(m_curlRequest, nullptr)) {
+            curlRequest->invalidateClient();
+            curlRequest->cancel();
+        }
+    }
+
+    // Apotheosis: report a terminal condition to the client. Ordering matters -- didFinishLoading()
+    // and didFail() usually drop the last reference to the ResourceHandle, which runs
+    // ~ResourceHandle() -> detach() -> our own destruction, so we protect `this`, read what we
+    // need, detach first and only then call out.
+    template<typename Callback> void reportTerminal(Callback&& callback)
+    {
+        Ref protectedThis { *this };
+        auto* client = this->client();
+        auto* handle = m_handle;
+        // Apotheosis 2026-09-24: set BEFORE detach(), because the normal path calls detach() too and
+        // detach() is where the never-terminated case reports itself. Ordering is the whole point.
+        m_reportedTerminal = true;
+        detach();
+        if (client)
+            callback(*client, handle);
+    }
+
+    void curlDidSendData(CurlRequest&, unsigned long long bytesSent, unsigned long long totalBytesToBeSent) final
+    {
+        if (auto* client = this->client())
+            client->didSendData(m_handle, bytesSent, totalBytesToBeSent);
+    }
+
+    void curlDidReceiveResponse(CurlRequest&, CurlResponse&& receivedResponse) final
+    {
+        ASSERT(isMainThread());
+
+        auto* client = this->client();
+        if (!client) {
+            detach();
+            return;
+        }
+
+        ResourceResponse response(receivedResponse);
+        // Apotheosis 2026-09-24: per-hop evidence. `redir=1` here with no matching `RH: redir`
+        // line below would mean the hop was consumed by something other than startRedirect().
+        apoLoaderTrace("RH: resp %s http=%d redir=%d", apoLoaderLeaf(m_request.url()).data(),
+            response.httpStatusCode(), response.isRedirection() ? 1 : 0);
+        if (response.isRedirection() && startRedirect(response))
+            return;
+
+        // curl paused the transfer after the headers so that the client can still cancel or
+        // redirect before any body arrives; completeDidReceiveResponse() unpauses it. The client
+        // may answer synchronously and cancel from inside, hence the null check.
+        client->didReceiveResponseAsync(m_handle, WTF::move(response), [protectedThis = Ref { *this }] {
+            if (protectedThis->m_curlRequest)
+                protectedThis->m_curlRequest->completeDidReceiveResponse();
+        });
+    }
+
+    void curlDidReceiveData(CurlRequest&, Ref<SharedBuffer>&& buffer) final
+    {
+        if (auto* client = this->client())
+            client->didReceiveBuffer(m_handle, buffer.get(), static_cast<int>(buffer->size()));
+    }
+
+    void curlDidComplete(CurlRequest&, NetworkLoadMetrics&& metrics) final
+    {
+        // Apotheosis 2026-09-24: the other half of the decisive pair. `RH: done` with no matching
+        // `RH: DETACH-BEFORE-TERMINAL` means this handle reported success to its client, so a
+        // resource that is nevertheless still Pending lost its completion ABOVE this class; `RH:
+        // done` absent altogether points below it, at curl.
+        apoLoaderTrace("RH: done %s", apoLoaderLeaf(m_request.url()).data());
+        reportTerminal([&](ResourceHandleClient& client, ResourceHandle* handle) {
+            client.didFinishLoading(handle, metrics);
+        });
+    }
+
+    void curlDidFailWithError(CurlRequest&, ResourceError&& error, CertificateInfo&&) final
+    {
+        apoLoaderTrace("RH: fail %s err=%s/%d desc=%.120s", apoLoaderLeaf(m_request.url()).data(),
+            error.domain().utf8().data(), error.errorCode(), error.localizedDescription().utf8().data());
+        reportTerminal([&](ResourceHandleClient& client, ResourceHandle* handle) {
+            client.didFail(handle, error);
+        });
+    }
+
+    // Apotheosis: libcurl is deliberately never asked to follow redirects (CURLOPT_FOLLOWLOCATION
+    // is not set anywhere in the curl port), because WebCore has to see every hop: the
+    // SubresourceLoader re-applies CSP, mixed-content and CORS checks per hop and CachedResource
+    // records the final URL. Returns true when this response was consumed as a redirect.
+    bool startRedirect(ResourceResponse& response)
+    {
+        String location = response.httpHeaderField(HTTPHeaderName::Location);
+        if (location.isEmpty())
+            return false;
+
+        URL redirectedURL { response.url(), location };
+        if (!redirectedURL.isValid())
+            return false;
+
+        static constexpr unsigned maxRedirects = 20;
+        if (++m_redirectCount > maxRedirects) {
+            URL failingURL = response.url();
+            reportTerminal([&](ResourceHandleClient& client, ResourceHandle* handle) {
+                client.didFail(handle, ResourceError(CURLE_TOO_MANY_REDIRECTS, failingURL));
+            });
+            return true;
+        }
+
+        ResourceRequest redirectedRequest = m_request;
+        // Apotheosis: setURL() takes a URL&& in this tree, and redirectedURL is still needed
+        // below for the cross-origin check, so hand it a copy rather than moving it away.
+        redirectedRequest.setURL(URL { redirectedURL });
+
+        // RFC 9110 s15.4: 303, and 301/302 answering a POST, continue as a bodyless GET.
+        int statusCode = response.httpStatusCode();
+        if (statusCode == 303 || ((statusCode == 301 || statusCode == 302) && redirectedRequest.httpMethod() == "POST"_s)) {
+            redirectedRequest.setHTTPMethod("GET"_s);
+            redirectedRequest.setHTTPBody(nullptr);
+            redirectedRequest.clearHTTPContentType();
+        }
+
+        // Never carry credentials across an origin change.
+        if (!protocolHostAndPortAreEqual(m_request.url(), redirectedURL))
+            redirectedRequest.clearHTTPAuthorization();
+
+        apoLoaderTrace("RH: redir %s http=%d -> %.160s", apoLoaderLeaf(m_request.url()).data(), statusCode,
+            redirectedURL.string().utf8().data());
+
+        // Stop this hop before asking the client, which may answer synchronously.
+        stopTransfer();
+
+        auto* client = this->client();
+        client->willSendRequestAsync(m_handle, WTF::move(redirectedRequest), ResourceResponse(response),
+            [protectedThis = Ref { *this }](ResourceRequest&& newRequest) mutable {
+                // A null request means the client refused the redirect (CSP, a cancelled load).
+                // It has already reported that to its own client; we only stop.
+                if (newRequest.isNull() || !protectedThis->m_handle) {
+                    protectedThis->detach();
+                    return;
+                }
+                protectedThis->m_request = WTF::move(newRequest);
+                protectedThis->start();
+            });
+        return true;
+    }
+
+    ResourceHandle* m_handle { nullptr };
+    ResourceRequest m_request;
+    RefPtr<CurlRequest> m_curlRequest;
+    unsigned m_redirectCount { 0 };
+    // Apotheosis 2026-09-24: whether a terminal callback was handed to the client. Read by
+    // detach(), which reports the load as never-terminated when this is still false.
+    bool m_reportedTerminal { false };
+};
+
+// Apotheosis: per-handle bridge state lives here rather than in ResourceHandleInternal on
+// purpose. ResourceHandleInternal.h is included across a large part of WebCore, so adding a
+// field to it would rebuild most of the tree -- hours on this build machine -- whereas
+// everything here fits in the single translation unit that already owns these members.
+// Main-thread only, like every other member below.
+using PortCurlLoadMap = HashMap<ResourceHandle*, RefPtr<PortCurlLoad>>;
+static PortCurlLoadMap& portCurlLoads()
+{
+    ASSERT(isMainThread());
+    static NeverDestroyed<PortCurlLoadMap> map;
+    return map;
+}
+
+} // anonymous namespace
+
+ResourceHandle::~ResourceHandle()
+{
+    if (RefPtr load = portCurlLoads().take(this))
+        load->detach();
+}
+
+bool ResourceHandle::start()
+{
+    ASSERT(isMainThread());
+
+    // No client means nobody to deliver to; returning false makes create() return nullptr, which
+    // ResourceLoader treats as "this load did not start".
+    if (!client())
+        return false;
+
+    auto load = PortCurlLoad::create(*this, ResourceRequest { firstRequest() });
+    portCurlLoads().set(this, load.ptr());
+    apoLoaderTrace("RH: start %s", apoLoaderLeaf(firstRequest().url()).data());
+    load->start();
+    return true;
+}
+
+void ResourceHandle::cancel()
+{
+    ASSERT(isMainThread());
+
+    if (RefPtr load = portCurlLoads().take(this)) {
+        // Apotheosis 2026-09-24: named separately from the DETACH line detach() will write, because
+        // this one names the *insistence*: cancel() is only ever reached from a caller that has
+        // decided the load is over (ResourceLoader::cancel, stopAllLoaders, teardown).
+        apoLoaderTrace("RH: CANCEL %s", apoLoaderLeaf(firstRequest().url()).data());
+        load->detach();
+    }
